    },
    {
      "id": "en-1980",
      "language": "en",
      "file": "/assets/corpus/en-12741024238657315067.wav",
      "text": "Unfortunately, studying traffic flow is difficult because driver behavior cannot be predicted with one-hundred percent certainty.",
      "dataset_text_normalized": "unfortunately studying traffic flow is difficult because driver behavior cannot be predicted with one-hundred percent certainty",

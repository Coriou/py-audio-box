    {
      "id": "fr-1679",
      "language": "fr",
      "file": "/assets/corpus/fr-17999210160761730950.wav",
      "text": "Le groupe Aerosmith a annulé les derniers concerts de sa tournée.",
      "dataset_text_normalized": "le groupe aerosmith a annulé les derniers concerts de sa tournée",
      "source_row_id": "1679",

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://py-audio-box.local/auto-sfx/private-split-v1.schema.json",
  "title": "Auto-SFX operator-only source split mapping v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "corpus_id", "reservation_id", "reserved_at_utc",
    "source_manifest_sha256", "algorithm", "fractions",
    "assignment_commitment_hmac_sha256", "groups"
  ],
  "properties": {
    "schema_version": {"const": "auto-sfx-private-split/v1"},
    "corpus_id": {"type": "string"},
    "reservation_id": {"type": "string"},
    "reserved_at_utc": {"type": "string"},
    "source_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "algorithm": {"type": "string"},
    "fractions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["challenge", "locked_holdout"],
      "properties": {
        "challenge": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
        "locked_holdout": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1}
      }
    },
    "assignment_commitment_hmac_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_group_id", "role", "clip_ids", "content_sha256"],
        "properties": {
          "source_group_id": {"type": "string", "pattern": "^sg-[0-9a-f]{20}$"},
          "role": {"enum": ["development", "challenge", "locked_holdout"]},
          "clip_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
          "content_sha256": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
        }
      }
    }
  }
}

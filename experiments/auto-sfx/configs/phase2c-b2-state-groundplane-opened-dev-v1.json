{
  "schema_version": 1,
  "experiment_id": "phase2c-b2-state-groundplane-opened-dev-v1-a1",
  "evidence_boundary": "All Phase 2B shards are opened diagnostics with agent-draft truth. No challenge/locked corpus exists, and no contact accuracy is claimed. Development-only comparison diagnoses mechanism bias; it is not the operator-gold gate.",
  "fold": "development",
  "maximum_candidate_wall_seconds": 8.0,
  "maximum_candidate_peak_rss_mib": 256.0,
  "candidate_config": {
    "geometry_mode": "shot_local",
    "state_mode": "semi_markov"
  },
  "baseline_config": {},
  "variants": {
    "baseline": {
      "kind": "contact-state-v1"
    },
    "control_apex_rolling": {
      "kind": "contact-groundplane-v1",
      "geometry_mode": "rolling_quantile_control",
      "state_mode": "phase_apex_control"
    },
    "geometry_only": {
      "kind": "contact-groundplane-v1",
      "geometry_mode": "shot_local",
      "state_mode": "phase_apex_control"
    },
    "state_only": {
      "kind": "contact-groundplane-v1",
      "geometry_mode": "rolling_quantile_control",
      "state_mode": "semi_markov"
    },
    "candidate": {
      "kind": "contact-groundplane-v1",
      "geometry_mode": "shot_local",
      "state_mode": "semi_markov"
    }
  },
  "decision_gates": {
    "recall_slack": 0.05,
    "offset_like_mode_fraction": 0.8,
    "accept_requires": [
      "candidate_signed_median_closer_to_zero_than_baseline",
      "candidate_signed_median_greater_than_baseline",
      "not_offset_like",
      "candidate_diagnostic_median_abs_le_baseline",
      "candidate_strict_recall_ge_baseline_minus_slack",
      "candidate_simultaneous_lr_eq_0",
      "geometry_abstention_explicit",
      "wall_and_rss_within_budget"
    ],
    "reject_if_any": [
      "offset_like",
      "signed_bias_not_improved",
      "recall_drop_gt_slack",
      "tests_fail",
      "global_offset_key_exists"
    ],
    "inconclusive_if": "mixed_and_not_offset_like"
  }
}

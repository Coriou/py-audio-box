{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:py-audio-box:contracts:1.0.0",
  "title": "Speech workspace contract 1.0.0",
  "$defs": {
    "identity": {
      "type": "object",
      "properties": {
        "engine": {
          "enum": [
            "qwen",
            "kokoro",
            "pocket-tts"
          ]
        },
        "model": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "bundle_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "device": {
          "enum": [
            "auto",
            "cpu",
            "cuda",
            "metal"
          ]
        },
        "precision": {
          "enum": [
            "auto",
            "float32",
            "float16",
            "bfloat16",
            "int8"
          ]
        }
      },
      "required": [
        "engine",
        "model",
        "bundle_sha256",
        "device",
        "precision"
      ],
      "additionalProperties": false
    },
    "resolution": {
      "type": "object",
      "properties": {
        "requested": {
          "$ref": "#/$defs/identity"
        },
        "effective": {
          "$ref": "#/$defs/identity"
        },
        "fallback": {
          "enum": [
            "forbid",
            "allow_cpu"
          ]
        },
        "reason": {
          "type": "string"
        },
        "profile_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        }
      },
      "required": [
        "requested",
        "effective",
        "fallback",
        "reason",
        "profile_id"
      ],
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "synthetic",
            "upload",
            "microphone",
            "https",
            "youtube",
            "legacy"
          ]
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "source_id": {
          "type": "string"
        },
        "missing_fields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "kind",
        "source_sha256",
        "source_id",
        "missing_fields"
      ],
      "additionalProperties": false
    },
    "asset": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "frames": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "sample_rate": {
          "type": "integer",
          "minimum": 1,
          "maximum": 384000
        },
        "channels": {
          "enum": [
            1,
            2
          ]
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      },
      "required": [
        "id",
        "sha256",
        "frames",
        "sample_rate",
        "channels",
        "provenance"
      ],
      "additionalProperties": false
    },
    "voice_version": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "voice_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "origin": {
          "enum": [
            "preset",
            "clone",
            "design"
          ]
        },
        "reference_asset_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          }
        },
        "reference_text": {
          "type": "string"
        },
        "identity": {
          "$ref": "#/$defs/identity"
        },
        "settings_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      },
      "required": [
        "id",
        "voice_id",
        "origin",
        "reference_asset_ids",
        "reference_text",
        "identity",
        "settings_sha256",
        "provenance"
      ],
      "additionalProperties": false
    },
    "voice": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          }
        },
        "version_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          }
        },
        "archived": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "aliases",
        "version_ids",
        "archived"
      ],
      "additionalProperties": false
    },
    "speaker": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "voice_version_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        }
      },
      "required": [
        "id",
        "voice_version_id"
      ],
      "additionalProperties": false
    },
    "block": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "speaker_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "text": {
          "type": "string"
        },
        "selected_take_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "settings_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "id",
        "speaker_id",
        "text",
        "selected_take_id",
        "settings_sha256"
      ],
      "additionalProperties": false
    },
    "take": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "block_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "text": {
          "type": "string"
        },
        "voice_version_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "settings_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "asset_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "identity": {
          "$ref": "#/$defs/resolution"
        }
      },
      "required": [
        "id",
        "block_id",
        "text",
        "voice_version_id",
        "settings_sha256",
        "asset_id",
        "identity"
      ],
      "additionalProperties": false
    },
    "track": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "mute": {
          "type": "boolean"
        },
        "solo": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "mute",
        "solo"
      ],
      "additionalProperties": false
    },
    "clip": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "track_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "asset_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "take_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "start": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "in_tick": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "out_tick": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "gain": {
          "type": "number",
          "minimum": 0,
          "maximum": 16
        },
        "fade_in": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "fade_out": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "mute": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "track_id",
        "asset_id",
        "take_id",
        "start",
        "in_tick",
        "out_tick",
        "gain",
        "fade_in",
        "fade_out",
        "mute"
      ],
      "additionalProperties": false
    },
    "render_policy": {
      "type": "object",
      "properties": {
        "sample_rate": {
          "const": 48000
        },
        "format": {
          "const": "wav_pcm24"
        },
        "channels": {
          "enum": [
            1,
            2
          ]
        },
        "channel_mapping": {
          "enum": [
            "mono_duplicate_stereo_average"
          ]
        },
        "clipping": {
          "const": "fail"
        },
        "include_stale": {
          "type": "boolean"
        },
        "length_ticks": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "sample_rate",
        "format",
        "channels",
        "channel_mapping",
        "clipping",
        "include_stale",
        "length_ticks"
      ],
      "additionalProperties": false
    },
    "project": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "speakers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/speaker"
          }
        },
        "blocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/block"
          }
        },
        "takes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/take"
          }
        },
        "tracks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/track"
          }
        },
        "clips": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/clip"
          }
        },
        "assets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/asset"
          }
        },
        "voices": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/voice"
          }
        },
        "voice_versions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/voice_version"
          }
        },
        "render": {
          "$ref": "#/$defs/render_policy"
        }
      },
      "required": [
        "schema_version",
        "id",
        "revision",
        "speakers",
        "blocks",
        "takes",
        "tracks",
        "clips",
        "assets",
        "voices",
        "voice_versions",
        "render"
      ],
      "additionalProperties": false
    },
    "attempt": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "generation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "owner_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "reaped": {
          "type": "boolean"
        },
        "staging_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        }
      },
      "required": [
        "id",
        "generation",
        "owner_id",
        "reaped",
        "staging_id"
      ],
      "additionalProperties": false
    },
    "job": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "operation": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "input_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "principal_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "idempotency_key": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "state": {
          "enum": [
            "queued",
            "running",
            "cancel_requested",
            "cancelled",
            "succeeded",
            "failed"
          ]
        },
        "generation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "attempts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/attempt"
          }
        },
        "artifact_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          }
        },
        "stage": {
          "type": "string"
        },
        "deadline": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "operation",
        "input_sha256",
        "principal_id",
        "idempotency_key",
        "state",
        "generation",
        "attempts",
        "artifact_ids",
        "stage",
        "deadline"
      ],
      "additionalProperties": false
    },
    "artifact": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "job_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "generation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "asset_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          }
        },
        "input_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "project_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "manifest_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "identity": {
          "$ref": "#/$defs/resolution"
        }
      },
      "required": [
        "id",
        "job_id",
        "generation",
        "asset_ids",
        "input_sha256",
        "project_revision",
        "manifest_sha256",
        "identity"
      ],
      "additionalProperties": false
    },
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "enum": [
            "revision_conflict",
            "idempotency_conflict",
            "unsupported_control",
            "not_ready",
            "resource_limit",
            "invalid_media",
            "invalid_request",
            "not_found",
            "forbidden",
            "stale_attempt",
            "cancel_pending",
            "missing_media",
            "stale_take",
            "clipping",
            "migration_collision"
          ]
        },
        "message": {
          "type": "string",
          "maxLength": 512
        },
        "field": {
          "type": "string"
        },
        "action": {
          "type": "string"
        },
        "current_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "changed_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "maxItems": 20
        }
      },
      "required": [
        "code",
        "message",
        "field",
        "action",
        "current_revision",
        "changed_ids"
      ],
      "additionalProperties": false
    },
    "list": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "maxItems": 20
        },
        "next_cursor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "items",
        "next_cursor"
      ],
      "additionalProperties": false
    },
    "profile": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "device": {
          "enum": [
            "cpu",
            "cuda",
            "metal"
          ]
        },
        "topology": {
          "enum": [
            "networkless_container",
            "packaged_native"
          ]
        },
        "support": {
          "enum": [
            "unqualified",
            "qualified",
            "unsupported"
          ]
        },
        "installation": {
          "enum": [
            "absent",
            "installed"
          ]
        },
        "configuration": {
          "enum": [
            "valid",
            "invalid"
          ]
        },
        "readiness": {
          "enum": [
            "not_ready",
            "ready",
            "busy",
            "quarantined"
          ]
        },
        "verification": {
          "enum": [
            "synthetic",
            "measured"
          ]
        },
        "checked_at": {
          "type": "string"
        },
        "qualification_receipt": {
          "type": "string"
        },
        "limits": {
          "type": "object",
          "properties": {
            "expensive_slots": {
              "type": "integer",
              "minimum": 1,
              "maximum": 64
            },
            "resident_models": {
              "type": "integer",
              "minimum": 1,
              "maximum": 64
            },
            "threads": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1024
            },
            "queue": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000
            },
            "upload_bytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "decoded_ticks": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "text_chars": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "variants": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "disk_bytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "deadline_seconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 86400
            },
            "ram_bytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "vram_bytes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "expensive_slots",
            "resident_models",
            "threads",
            "queue",
            "upload_bytes",
            "decoded_ticks",
            "text_chars",
            "variants",
            "disk_bytes",
            "deadline_seconds",
            "ram_bytes",
            "vram_bytes"
          ],
          "additionalProperties": false
        },
        "next_action": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "device",
        "topology",
        "support",
        "installation",
        "configuration",
        "readiness",
        "verification",
        "checked_at",
        "qualification_receipt",
        "limits",
        "next_action"
      ],
      "additionalProperties": false
    },
    "capabilities": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": "1.0.0"
        },
        "profiles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/profile"
          }
        },
        "operations": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          }
        },
        "engines": {
          "type": "array",
          "items": {
            "enum": [
              "qwen",
              "kokoro",
              "pocket-tts"
